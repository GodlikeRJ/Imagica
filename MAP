                        Slide Mechanics Timeline
                    </h3>

                    <div
                        class="space-y-3 border-l border-slate-800 pl-3 ml-1.5"
                        id="timeline-steps">

                        <!-- Dynamic timeline steps -->

                    </div>

                </div>

            </div>

        </div>
    </div>


    <!-- ================= BOTTOM NAVIGATION BAR ================= -->

