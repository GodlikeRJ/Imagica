// Render Cards based on Active Tab Filters
function renderSlides(filter = "all") {
const container = document.getElementById("slides-list");
container.innerHTML = "";
const filtered = slidesData.filter(slide => {
if (filter === "all") return true;
return slide.status === filter;
});
filtered.forEach(slide => {
const card = document.createElement("div");
card.className = slide-card p-3.5 bg-slate-900/60 rounded-xl border ${slide.color} flex items-center justify-between gap-3 cursor-pointer;
card.onclick = () => showPath(slide.id);
card.innerHTML = <div class="flex items-center gap-3 min-w-0"> <div class="w-10 h-10 rounded-xl bg-slate-950 flex items-center justify-center text-lg border border-slate-800 shrink-0"> ${slide.icon} </div> <div class="min-w-0"> <div class="flex items-center gap-2 flex-wrap"> <h3 class="text-sm font-bold text-white truncate">${slide.name}</h3> <span class="text-[9px] px-1.5 py-0.5 rounded font-medium bg-slate-950 border border-slate-800 text-slate-300">${slide.badge}</span> </div> <p class="text-xs text-slate-400 mt-0.5 line-clamp-1">${slide.desc}</p> </div> </div> <div class="text-right shrink-0"> <span class="text-[11px] font-bold text-cyan-400 bg-cyan-950/40 border border-cyan-900/50 px-2.5 py-1 rounded-lg">View Path →</span> </div>;
container.appendChild(card);
});
}
// Handle Filter Tab UI toggling
function filterSlides(filter) {
['all', 'approved', 'excluded'].forEach(item => {
const tab = document.getElementById(tab-${item});
if (item === filter) {
tab.className = "px-3 py-1.5 bg-cyan-600 text-white text-xs font-semibold rounded-full whitespace-nowrap shadow-md shadow-cyan-500/10 border border-cyan-500/20 transition-all";
} else {
tab.className = "px-3 py-1.5 bg-slate-900 text-slate-400 text-xs font-medium rounded-full whitespace-nowrap border border-slate-800 transition-all";
}
});
renderSlides(filter);
}
// View Specific Slide Path PathOverlay Module
function showPath(id) {
const slide = slidesData.find(s => s.id === id);
if (!slide) return;
document.getElementById("overlay-title").innerText = slide.name + " (" + slide.type + ")";
document.getElementById("overlay-path-desc").innerText = slide.pathDesc;
document.getElementById("svg-path").innerHTML = slide.svgPath;
const badge = document.getElementById("overlay-status-badge");
badge.innerText = slide.status.toUpperCase();
if (slide.status === 'approved') {
badge.className = "text-[10px] px-2 py-0.5 rounded-full font-bold bg-emerald-950 text-emerald-400 border border-emerald-800";
} else {
badge.className = "text-[10px] px-2 py-0.5 rounded-full font-bold bg-rose-950 text-rose-400 border border-rose-800";
}
const stepsContainer = document.getElementById("timeline-steps");
stepsContainer.innerHTML = "";
slide.steps.forEach(step => {
const stepElem = document.createElement("div");
stepElem.className = "relative text-xs";
stepElem.innerHTML = <span class="font-bold text-cyan-400 block">${step.time}</span> <span class="text-slate-300">${step.note}</span>;
stepsContainer.appendChild(stepElem);
});
const overlay = document.getElementById("path-overlay");
overlay.classList.remove("hidden");
setTimeout(() => {
overlay.classList.remove("translate-y-full");
}, 10);
}
function closePath() {
const overlay = document.getElementById("path-overlay");
overlay.classList.add("translate-y-full");
setTimeout(() => {
overlay.classList.add("hidden");
}, 300);
}
// Toggle Full Itinerary view schedule
let itineraryOpen = false;
function toggleItineraryView() {
const modal = document.getElementById("itinerary-modal");
if (!itineraryOpen) {
modal.classList.remove("hidden");
setTimeout(() => modal.classList.remove("translate-y-full"), 10);
} else {
modal.classList.add("translate-y-full");
setTimeout(() => modal.classList.add("hidden"), 300);
}
itineraryOpen = !itineraryOpen;
}
// Initialize App UI
window.onload = () => {
renderSlides('all');
// Dynamic timeline clock tick simulation
const times = ["11:00 AM", "12:15 PM", "1:30 PM", "2:45 PM", "4:00 PM", "4:45 PM"];
let idx = 0;
setInterval(() => {
idx = (idx + 1) % times.length;
document.getElementById("time-badge").innerText = times[idx];
}, 8000);
};

