        // ==========================================
        // RENDER SLIDE CARDS
        // ==========================================

        function renderSlides(filter = "all") {

            const container = document.getElementById("slides-list");

            container.innerHTML = "";

            const filtered = slidesData.filter(slide => {

                if (filter === "all") {
                    return true;
                }

                return slide.status === filter;

            });


            if (filtered.length === 0) {

                container.innerHTML = `
                    <p class="text-center text-sm text-slate-400 py-8">
                        No slides found in this category.
                    </p>
                `;

                return;
            }


            filtered.forEach(slide => {

                const card = document.createElement("button");

                card.type = "button";

                card.className = `
                    slide-card w-full text-left
                    p-3.5 bg-slate-900/60
                    rounded-xl border ${slide.color}
                    flex items-center justify-between
                    gap-3 cursor-pointer
                `;


                card.innerHTML = `

                    <div class="flex items-center gap-3 min-w-0">

                        <div class="w-10 h-10 rounded-xl bg-slate-950
                            flex items-center justify-center text-lg
                            border border-slate-800 shrink-0">

                            ${slide.icon}

                        </div>


                        <div class="min-w-0">

                            <div class="flex items-center gap-2 flex-wrap">

                                <h3 class="text-sm font-bold text-white truncate">
                                    ${slide.name}
                                </h3>

                                <span class="text-[9px] px-1.5 py-0.5
                                    rounded font-medium bg-slate-950
                                    border border-slate-800 text-slate-300">

                                    ${slide.badge}

                                </span>

                            </div>


                            <p class="text-xs text-slate-400 mt-0.5 line-clamp-2">
                                ${slide.desc}
                            </p>

                        </div>

                    </div>


                    <div class="text-right shrink-0">

                        <span class="text-[11px] font-bold text-cyan-400
                            bg-cyan-950/40 border border-cyan-900/50
                            px-2.5 py-1 rounded-lg whitespace-nowrap">

                            View Path →

                        </span>

                    </div>

                `;


                card.addEventListener("click", () => {
                    showPath(slide.id);
                });


                container.appendChild(card);

            });

        }


        // ==========================================
        // FILTER TAB FUNCTION
        // ==========================================

        function filterSlides(filter) {

            const tabs = ["all", "approved", "excluded"];

            tabs.forEach(item => {

                const tab = document.getElementById(`tab-${item}`);

                if (item === filter) {

                    tab.className = `
                        px-3 py-1.5 bg-cyan-600 text-white
                        text-xs font-semibold rounded-full
                        whitespace-nowrap shadow-md
                        shadow-cyan-500/10 border
                        border-cyan-500/20 transition-all
                    `;

                    tab.setAttribute("aria-pressed", "true");

                } else {

                    tab.className = `
                        px-3 py-1.5 bg-slate-900 text-slate-400
                        text-xs font-medium rounded-full
                        whitespace-nowrap border
                        border-slate-800 transition-all
                    `;

                    tab.setAttribute("aria-pressed", "false");

                }

            });


            renderSlides(filter);

        }


        // ==========================================
        // PANEL OPEN/CLOSE HELPERS
        // ==========================================

        const panelTimers = new Map();

        function openPanel(id) {

            const panel = document.getElementById(id);

            clearTimeout(panelTimers.get(id));

            panel.classList.remove("hidden");

            panel.setAttribute("aria-hidden", "false");

            requestAnimationFrame(() => {
                panel.classList.remove("translate-y-full");
            });

        }


        function closePanel(id) {

            const panel = document.getElementById(id);

            panel.classList.add("translate-y-full");

            panel.setAttribute("aria-hidden", "true");

            const timer = setTimeout(() => {

                if (panel.classList.contains("translate-y-full")) {
                    panel.classList.add("hidden");
                }

            }, 300);

            panelTimers.set(id, timer);

        }


        // ==========================================
        // SHOW SLIDE PATH
        // ==========================================

        function showPath(id) {

            const slide = slidesData.find(s => s.id === id);

            if (!slide) {
                return;
            }


            // Update title

            document.getElementById("overlay-title").innerText =
                `${slide.name} (${slide.type})`;


            // Update description

            document.getElementById("overlay-path-desc").innerText =
                slide.pathDesc;


            // Render SVG path

            document.getElementById("svg-path").innerHTML =
                slide.svgPath;


            // Update status badge

            const badge = document.getElementById("overlay-status-badge");

            badge.innerText = slide.status.toUpperCase();


            if (slide.status === "approved") {

                badge.className = `
                    text-[10px] px-2 py-0.5 rounded-full
                    font-bold bg-emerald-950
                    text-emerald-400 border border-emerald-800
                `;

            } else {

                badge.className = `
                    text-[10px] px-2 py-0.5 rounded-full
                    font-bold bg-rose-950
                    text-rose-400 border border-rose-800
                `;

            }


            // Render timeline steps

            const stepsContainer =
                document.getElementById("timeline-steps");

            stepsContainer.innerHTML = "";


            slide.steps.forEach(step => {

                const stepElem = document.createElement("div");

                stepElem.className = "relative text-xs";


                const timeElem = document.createElement("span");

                timeElem.className = "font-bold text-cyan-400 block";

                timeElem.innerText = step.time;


                const noteElem = document.createElement("span");

                noteElem.className = "text-slate-300";

                noteElem.innerText = step.note;


                stepElem.appendChild(timeElem);

                stepElem.appendChild(noteElem);

                stepsContainer.appendChild(stepElem);

            });


            // Display overlay

            openPanel("path-overlay");

        }


        // ==========================================
        // CLOSE SLIDE PATH
        // ==========================================

        function closePath() {

            closePanel("path-overlay");

        }


        // ==========================================
        // TOGGLE ITINERARY
        // ==========================================

        function toggleItineraryView() {

            const modal = document.getElementById("itinerary-modal");

            const isOpen =
                modal.getAttribute("aria-hidden") === "false";


            if (isOpen) {

                closePanel("itinerary-modal");

            } else {

                openPanel("itinerary-modal");

            }

        }


        // ==========================================
        // LIVE CLOCK
        // ==========================================

        function updateClock() {

            const now = new Date();

            const currentTime = now.toLocaleTimeString("en-IN", {
                hour: "numeric",
                minute: "2-digit",
                hour12: true
            });

            document.getElementById("time-badge").innerText =
                currentTime;

        }


        // ==========================================
        // ESCAPE KEY SUPPORT
        // ==========================================

        document.addEventListener("keydown", event => {

            if (event.key === "Escape") {

                const pathOverlay = document.getElementById("path-overlay");

                const itineraryModal = document.getElementById("itinerary-modal");


                if (pathOverlay.getAttribute("aria-hidden") === "false") {
                    closePath();
                }

                if (itineraryModal.getAttribute("aria-hidden") === "false") {
                    closePanel("itinerary-modal");
                }

            }

        });


        // ==========================================
        // INITIALIZE APP
        // ==========================================

        window.addEventListener("DOMContentLoaded", () => {

            renderSlides("all");

            updateClock();

            // Update actual device time every 30 seconds
            setInterval(updateClock, 30000);

        });

    </script>

</body>
</html>
