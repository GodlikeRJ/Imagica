<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>BOARDquest: Aquamagica Slide Navigator</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #0b132b;
        }

        .slide-card {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .slide-card:hover {
            transform: translateY(-4px);
        }

        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #0b132b;
        }

        ::-webkit-scrollbar-thumb {
            background: #1c2541;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #3a506b;
        }
    </style>
</head>

<body class="text-slate-100 min-h-screen flex flex-col selection:bg-cyan-500 selection:text-white">

    <!-- ================= TOP NAVIGATION ================= -->

    <header class="sticky top-0 z-40 bg-[#0b132b]/80 backdrop-blur-md border-b border-slate-800/80 px-4 py-3">
        <div class="max-w-md mx-auto flex items-center justify-between">

            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-blue-600 to-cyan-400 flex items-center justify-center font-bold text-white shadow-lg shadow-blue-500/20">
                    AQ
                </div>

                <div>
                    <h1 class="text-sm font-bold tracking-tight text-white flex items-center gap-1">
                        BOARDquest
                        <span class="text-xs text-cyan-400 font-normal">v1.2</span>
                    </h1>

                    <p class="text-[10px] text-slate-400">
                        Don Bosco Picnic • Nov 20
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-2 text-xs bg-slate-900/90 px-2.5 py-1.5 rounded-full border border-slate-800">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="text-slate-300 font-medium" id="time-badge">--:--</span>
            </div>

        </div>
    </header>


    <!-- ================= MAIN CONTENT ================= -->

    <main class="flex-1 max-w-md w-full mx-auto p-4 space-y-4 pb-24">

        <!-- FILTER TABS -->

        <div class="flex gap-2 overflow-x-auto pb-1" id="filter-container">

            <button
                onclick="filterSlides('all')"
                id="tab-all"
                aria-pressed="true"
                class="px-3 py-1.5 bg-cyan-600 text-white text-xs font-semibold rounded-full whitespace-nowrap shadow-md shadow-cyan-500/10 border border-cyan-500/20 transition-all">

                All Slides
            </button>

            <button
                onclick="filterSlides('approved')"
                id="tab-approved"
                aria-pressed="false"
                class="px-3 py-1.5 bg-slate-900 text-slate-400 text-xs font-medium rounded-full whitespace-nowrap border border-slate-800 transition-all">

                ⭐ Approved Route
            </button>

            <button
                onclick="filterSlides('excluded')"
                id="tab-excluded"
                aria-pressed="false"
                class="px-3 py-1.5 bg-slate-900 text-slate-400 text-xs font-medium rounded-full whitespace-nowrap border border-slate-800 transition-all">

                ❌ Excluded Thrills
            </button>

        </div>


        <!-- DYNAMIC SLIDE CARDS -->

        <div class="space-y-3" id="slides-list">
            <!-- Slide cards are generated using JavaScript -->
        </div>

    </main>


    <!-- ================= SLIDE PATH OVERLAY ================= -->

    <div
        id="path-overlay"
        class="fixed inset-0 z-50 hidden bg-[#0b132b]/95 transition-transform duration-300 translate-y-full"
        aria-hidden="true"
        role="dialog"
        aria-modal="true"
        aria-labelledby="overlay-title">

        <div class="min-h-full w-full max-w-md mx-auto flex flex-col">

            <!-- Overlay Header -->

            <div class="p-4 border-b border-slate-800 flex items-center justify-between">

                <div class="flex items-center gap-2">
                    <span
                        id="overlay-status-badge"
                        class="text-[10px] px-2 py-0.5 rounded-full font-bold">
                    </span>

                    <h2 id="overlay-title" class="text-base font-bold text-white">
                        Slide Path
                    </h2>
                </div>

                <button
                    onclick="closePath()"
                    aria-label="Close slide details"
                    class="w-8 h-8 rounded-full bg-slate-900 flex items-center justify-center border border-slate-800 text-slate-400 hover:text-white">

                    ✕
                </button>

            </div>


            <!-- Overlay Content -->

            <div class="flex-1 p-4 flex flex-col overflow-y-auto">

                <!-- SVG Path Display -->

                <div class="bg-slate-950 rounded-xl border border-slate-800 p-4 relative overflow-hidden flex-1 flex flex-col justify-center items-center min-h-[220px]">

                    <div class="absolute inset-0 opacity-10 bg-[linear-gradient(to_right,#808080_1px,transparent_1px),linear-gradient(to_bottom,#808080_1px,transparent_1px)] bg-[size:14px_24px]"></div>

                    <div class="w-full max-w-[280px] h-40 relative z-10 flex items-center justify-center">

                        <svg
                            id="svg-path"
                            class="w-full h-full"
                            viewBox="0 0 200 100"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg">

                            <!-- Dynamic SVG path gets inserted here -->

                        </svg>

                    </div>


                    <!-- Slide Description -->

                    <div class="w-full mt-4 bg-slate-900/60 p-3 rounded-lg border border-slate-800/50 space-y-1">

                        <span class="text-[10px] text-slate-400 uppercase tracking-wider block font-semibold">
                            Slide Architecture Breakdown
